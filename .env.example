# Copy to .env (or .env.local, which wins where both set a name) for
# development; set the same names in the hosting provider for production.
# Only the two NEXT_PUBLIC_ names below reach the browser, and they are meant to.

# Supabase Postgres, through the Supavisor pooler (port 6543, transaction mode).
# See src/lib/db.ts for why it must be the pooler URL.
DATABASE_URL=

# --- Sign-in, affiliate program and admin — see docs/affiliate.md -------------

# Supabase Auth: partners and admins sign in with it. Project Settings → API,
# the same project as DATABASE_URL. Both are public by design: the anon key
# ships in the browser bundle, and row-level security on the affiliate schema
# is what stops it reading anything. Without the pair, the sign-in pages refuse
# to render rather than showing a login form that cannot log anyone in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared with the Growsearch app, which signs every event that writes money into
# the ledger. Treat it like a payment key: 32 bytes minimum, never in a client
# bundle. Without it, /api/affiliate/events answers 503 to everything.
#   openssl rand -hex 32
AFFILIATE_INGEST_SECRET=

# The admin's Owner: comma-separated Supabase login emails with every
# permission, who can't be changed or locked out from inside the app.
# Everyone else is added on the admin's Team page — see docs/team.md.
# Deliberately an env var for the Owner alone, so no request can make
# somebody one. Empty means no Owner. (Named for the affiliate program,
# which had an admin first.)
AFFILIATE_ADMIN_EMAILS=

# Supabase's secret key (Project Settings → API Keys: `sb_secret_…`, or the
# older service_role key), used only by the Team page to create logins, reset
# passwords and turn off a lost two-step login, and by invites to create the
# invitee's login. It can do anything to any login: server only, never
# NEXT_PUBLIC. Without it, invites still work for people who already have a
# login; the rest says what is missing.
SUPABASE_SECRET_KEY=

# --- Sign-in email — see docs/affiliate.md, "The emails" ------------------------

# Confirmation and password-reset emails are sent by this site through Resend,
# not by Supabase. The same Resend account and names as the Growsearch app:
# EMAIL_FROM is "Name <address@domain>" on a domain verified in Resend, and
# EMAIL_REPLY_TO is where a reply goes (optional; defaults to the sender).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Signs the requests Supabase makes to /api/auth/send-email. Authentication →
# Hooks → Send Email in the Supabase dashboard generates it; paste it exactly as
# shown, "v1,whsec_..." included. Without it the endpoint answers 503, and with
# the hook switched on that fails every sign-up — set it before enabling the hook.
SEND_EMAIL_HOOK_SECRET=

# --- Merchant email in the admin — see docs/merchant-email.md -------------------

# Shared with the Growsearch app, and signs every request /admin/email makes to
# it: reading the merchant list, sending a campaign. Its own key rather than
# the affiliate one, so neither can do the other's job. The app holds the same
# value under the same name. Without it the Email page says it cannot load.
#   openssl rand -hex 32
PORTAL_EMAIL_SECRET=

# --- Release announcements — see docs/release-announcements.md -----------------

# Shared with the Growsearch app, which signs every request its
# `npm run announce` makes to /api/announcements: drafting a release's blog post
# and merchant email for approval in /admin/announcements. Its own key, not
# PORTAL_EMAIL_SECRET: drafting is not sending. The app holds the same value
# under the same name. At least 32 characters; without it the API answers 503.
#   openssl rand -hex 32
ANNOUNCE_SECRET=

# Your apps (/admin/apps): each app's shared secret, under the name its row in
# apps.app gives (always ending _ANALYTICS_SECRET). It signs the admin's
# requests for the app's store list and the passes that open a store's
# read-only dashboard. Growsearch holds the same value as
# PORTAL_ANALYTICS_SECRET. Without it the app's card says "Not connected".
#   openssl rand -hex 32
GROWSEARCH_ANALYTICS_SECRET=

# Where the Growsearch app is. Only set this to point at another deployment of
# it; the default is production.
# GROWSEARCH_APP_URL=https://smart-search-gsog.onrender.com

# --- Try-it-free preview (/try) ------------------------------------------------

# Signs the tokens behind preview links; see src/lib/preview/token.ts. Required
# in production so tokens verify across instances; development falls back to a
# random per-process secret and logs that it did.
PREVIEW_TOKEN_SECRET=
