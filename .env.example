# Copy to .env.local for development; set the same names in the hosting
# provider for production. Nothing here is ever sent to the browser — none of
# these names start with NEXT_PUBLIC_.

# Supabase Postgres, through the Supavisor pooler (port 6543, transaction mode).
# See src/lib/db.ts for why it must be the pooler URL.
DATABASE_URL=

# Signs the admin session cookie. At least 32 random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
SESSION_SECRET=

# The first admin account. Either run `npm run admin:create` with these set,
# or leave them set on the server and sign in once at /admin/login — while the
# database has no admin accounts, these credentials are accepted a single time
# and turned into a real account with a bcrypt-hashed password. After that the
# database is the only source of truth: remove these variables.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_NAME=
