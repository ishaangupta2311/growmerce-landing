# Copy to .env (or .env.local, which wins where both set a name) for
# development; set the same names in the hosting provider for production.
# Only the two NEXT_PUBLIC_ names below reach the browser, and they are meant to.

# Supabase Postgres, through the Supavisor pooler (port 6543, transaction mode).
# See src/lib/db.ts for why it must be the pooler URL.
DATABASE_URL=

# --- Blog admin (/admin) ------------------------------------------------------

# Signs the admin session cookie. At least 32 random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
SESSION_SECRET=

# The first admin account. Either run `npm run admin:create` with these set,
# or leave them set on the server and sign in once at /admin/login — while the
# database has no admin accounts, these credentials are accepted a single time
# and turned into a real account with a bcrypt-hashed password. After that the
# database is the only source of truth: remove these variables.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_NAME=

# --- Affiliate program (/affiliates) — see docs/affiliate.md ------------------

# Supabase Auth for partner sign-in. Project Settings → API, the same project
# as DATABASE_URL. Both are public by design: the anon key ships in the browser
# bundle, and row-level security on the affiliate schema is what stops it
# reading anything. Without the pair, every page under /affiliates refuses to
# render rather than showing a login form that cannot log anyone in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared with the Growsearch app, which signs every event that writes money into
# the ledger. Treat it like a payment key: 32 bytes minimum, never in a client
# bundle. Without it, /api/affiliate/events answers 503 to everything.
#   openssl rand -hex 32
AFFILIATE_INGEST_SECRET=

# Comma-separated Supabase login emails allowed into /affiliates/admin — to
# approve partners, change rates and record payouts. Deliberately an env var
# and not a table row, so adding an admin costs a deploy. Empty means nobody.
AFFILIATE_ADMIN_EMAILS=

# --- Try-it-free preview (/try) ------------------------------------------------

# Signs the tokens behind preview links; see src/lib/preview/token.ts. Required
# in production so tokens verify across instances; development falls back to a
# random per-process secret and logs that it did.
PREVIEW_TOKEN_SECRET=
