# Copy to .env (or .env.local, which wins where both set a name) for
# development; set the same names in the hosting provider for production.
# Only the two NEXT_PUBLIC_ names below reach the browser, and they are meant to.

# Supabase Postgres, through the Supavisor pooler (port 6543, transaction mode).
# See src/lib/db.ts for why it must be the pooler URL.
DATABASE_URL=

# --- Sign-in, affiliate program and admin — see docs/affiliate.md -------------

# Supabase Auth: partners and admins sign in with it. Project Settings → API,
# the same project as DATABASE_URL. Both are public by design: the anon key
# ships in the browser bundle, and row-level security on the affiliate schema
# is what stops it reading anything. Without the pair, the sign-in pages refuse
# to render rather than showing a login form that cannot log anyone in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared with the Growsearch app, which signs every event that writes money into
# the ledger. Treat it like a payment key: 32 bytes minimum, never in a client
# bundle. Without it, /api/affiliate/events answers 503 to everything.
#   openssl rand -hex 32
AFFILIATE_INGEST_SECRET=

# Comma-separated Supabase login emails allowed into /admin — the blog and the
# affiliate program both: publishing posts, approving partners, changing rates,
# recording payouts. Deliberately an env var and not a table row, so adding an
# admin costs a deploy. Empty means nobody. (Named for the affiliate program,
# which had an admin first; it now gates the whole admin.)
AFFILIATE_ADMIN_EMAILS=

# --- Try-it-free preview (/try) ------------------------------------------------

# Signs the tokens behind preview links; see src/lib/preview/token.ts. Required
# in production so tokens verify across instances; development falls back to a
# random per-process secret and logs that it did.
PREVIEW_TOKEN_SECRET=
